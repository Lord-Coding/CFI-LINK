<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         stopOnFailure="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">tests/Unit</directory>
        </testsuite>
        <testsuite name="Auth">
            <directory suffix="Test.php">tests/Feature/Auth</directory>
        </testsuite>
        <testsuite name="Authorization">
            <directory suffix="Test.php">tests/Feature/Authorization</directory>
        </testsuite>
        <testsuite name="Business">
            <directory suffix="Test.php">tests/Feature/Business</directory>
        </testsuite>
        <testsuite name="Validation">
            <directory suffix="Test.php">tests/Feature/Validation</directory>
        </testsuite>
        <testsuite name="Security">
            <directory suffix="Test.php">tests/Feature/Security</directory>
        </testsuite>
        <testsuite name="Performance">
            <directory suffix="Test.php">tests/Feature/Performance</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV"                value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS"          value="4"/>
        <env name="BROADCAST_CONNECTION"   value="null"/>
        <env name="CACHE_STORE"            value="array"/>
        <env name="DB_CONNECTION"          value="sqlite"/>
        <env name="DB_DATABASE"            value=":memory:"/>
        <env name="DB_URL"                 value=""/>
        <env name="MAIL_MAILER"            value="array"/>
        <env name="QUEUE_CONNECTION"       value="sync"/>
        <env name="SESSION_DRIVER"         value="array"/>
        <env name="RESEND_API_KEY"         value="test_fake_key"/>
        <env name="PULSE_ENABLED"          value="false"/>
        <env name="TELESCOPE_ENABLED"      value="false"/>
        <env name="NIGHTWATCH_ENABLED"     value="false"/>
    </php>
</phpunit>
